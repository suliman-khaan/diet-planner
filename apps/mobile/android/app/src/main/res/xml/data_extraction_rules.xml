<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher. Same scope as backup_rules.xml; exported files are never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="app_flutter/" />
        <exclude domain="file" path="app_flutter/exports/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="app_flutter/" />
        <exclude domain="file" path="app_flutter/exports/" />
    </device-transfer>
</data-extraction-rules>
